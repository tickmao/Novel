{
  "schema_version": 2,
  "block_domains": [
    "po18.tw",
    "po18.com",
    "po18xs.com",
    "po18book.com",
    "woo18.com",
    "cool18.com",
    "jmshuwu.net",
    "yuwangshe.net",
    "haitang123.com",
    "18comic.org"
  ],
  "domain_label_patterns": [
    "po18[a-z0-9-]*",
    "woo18[a-z0-9-]*",
    "cool18",
    "yushuwu[a-z0-9-]*",
    "18comic[a-z0-9-]*"
  ],
  "text_rules": [
    {
      "id": "explicit_adult_label",
      "pattern": "🔞|18\\s*(?:禁|\\+)|\\bR\\s*-?18\\b|成人(?:文学|小说|漫画|视频|专区|内容|网站)|色情|情色|肉文|肉漫|高\\s*H(?:文|小说|专区|分类)|H文专区",
      "decision": "block",
      "body": true,
      "body_decision": "review"
    },
    {
      "id": "adult_source_brand",
      "pattern": "御书屋|海棠书屋|新欲望社|欲书屋|禁漫|(?<![A-Za-z0-9])(?:PO18|WOO18|COOL18)(?![A-Za-z0-9])",
      "decision": "block"
    },
    {
      "id": "ambiguous_adult_promotion",
      "pattern": "擦边|福利专区|绅士专区|桃色小说|肉欲|高\\s*H(?:\\b|$)",
      "decision": "review"
    }
  ],
  "body_review_terms": [
    "性交",
    "乱伦",
    "阴茎",
    "阴道",
    "精液",
    "射精",
    "口交"
  ],
  "body_review_threshold": 2
}
